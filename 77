import urllib.request
import urllib.error

class MyFile:
    def __init__(self, path, mode):
        self.path = path
        self.mode = mode
    
    def read(self):
        if self.mode != "read":
            return "Ошибка: используй режим 'read'"
        
        try:
            with open(self.path, 'r', encoding='utf-8') as f:
                return f.read()
        except FileNotFoundError:
            return "Ошибка: файл не найден"
        except:
            return "Ошибка при чтении файла"
    
    def write(self, text):
        if self.mode not in ["write", "append"]:
            return "Ошибка: используй режим 'write' или 'append'"
        
        mode = 'w' if self.mode == "write" else 'a'
        try:
            with open(self.path, mode, encoding='utf-8') as f:
                f.write(text)
                return "Успешно записано!"
        except:
            return "Ошибка при записи"
    
    def read_url(self):
        if self.mode != "url":
            return "Ошибка: используй режим 'url'"
        
        try:
            with urllib.request.urlopen(self.path) as response:
                content = response.read()
                return content.decode('utf-8')
        except urllib.error.URLError:
            return "Ошибка: не удалось подключиться к URL"
        except:
            return "Ошибка при чтении URL"
    
    def write_url(self, filename):
        if self.mode != "url":
            return "Ошибка: используй режим 'url'"
        
        try:
            content = self.read_url()
            if content.startswith("Ошибка"):
                return content
            
            with open(filename, 'w', encoding='utf-8') as f:
                f.write(content)
            return f"Содержимое URL сохранено в файл '{filename}'"
        except:
            return "Ошибка при сохранении URL в файл"

